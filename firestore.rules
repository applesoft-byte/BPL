rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // --- Reference Numbers Collection (Superadmin & Registration Validation) ---
    match /reference_numbers/{refId} {
      allow read: if true;
      allow write: if true;
    }

    // --- App Users Collection (Mobile + Ref + Password Accounts) ---
    match /app_users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Legacy Users & Admins Collection ---
    match /users/{userId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    // --- Drafts Collection ---
    match /drafts/{draftId} {
      allow read, write: if true;
    }

    // --- Teams Collection ---
    match /teams/{teamId} {
      allow read, write: if true;
    }

    // --- Players Collection ---
    match /players/{playerId} {
      allow read, write: if true;
    }

    // --- Categories Collection ---
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // --- Picks Collection ---
    match /picks/{pickId} {
      allow read, write: if true;
    }
  }
}
